{
  "name": "governance-toolkit",
  "version": "0.1.0",
  "description": "Stellar Governance toolkit: indexer of on-chain proposals and votes, drafts, discussion, wallet sign-in and a read API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stellar-Governance/governance-toolkit.git"
  },
  "homepage": "https://github.com/Stellar-Governance/governance-toolkit#readme",
  "bugs": {
    "url": "https://github.com/Stellar-Governance/governance-toolkit/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.4.0",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "governance-toolkit": "dist/main.js"
  }
}
