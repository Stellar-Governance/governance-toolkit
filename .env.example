# Copy to .env and fill in. No secrets belong here: the toolkit never signs transactions.
# Network (testnet for this project). The passphrase is cross-checked against the network name.
STELLAR_NETWORK=
STELLAR_NETWORK_PASSPHRASE=
STELLAR_RPC_URL=
# Governance contract id (C...)
GOVERNANCE_CONTRACT_ID=
# First ledger to read events from when the database has no cursor yet (for example the deploy ledger)
TOOLKIT_START_LEDGER=
# SQLite file
TOOLKIT_DB_PATH=
# HTTP listener
TOOLKIT_HOST=
TOOLKIT_PORT=
# Comma-separated browser origins allowed by CORS (for example the frontend URL)
TOOLKIT_CORS_ORIGINS=
# Domain written into sign-in challenges (for example the frontend's host name)
TOOLKIT_AUTH_DOMAIN=
TOOLKIT_CHALLENGE_TTL_SECS=
TOOLKIT_SESSION_TTL_SECS=
TOOLKIT_INDEX_INTERVAL_MS=
TOOLKIT_RPC_TIMEOUT_MS=
TOOLKIT_RPC_RETRIES=
